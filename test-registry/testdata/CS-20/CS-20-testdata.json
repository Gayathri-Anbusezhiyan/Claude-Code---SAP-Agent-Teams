  "placeholders": {
    "{{MATERIAL_STANDARD}}": "Standard material ID (non-GMP-critical) — to be resolved from SAP tenant",
    "{{MATERIAL_GMP_CRITICAL}}": "GMP-critical material ID — to be resolved from SAP tenant",
    "{{MATERIAL_GROUP_GMP}}": "Material group code for GMP-critical materials — to be resolved from SAP configuration",
    "{{PLANT_CODE}}": "Valid plant code — to be resolved from SAP tenant",
    "{{INVALID_MATERIAL_ID}}": "Material ID that does NOT exist in the plant — e.g., INVALID001",
    "{{APPROVER_USER_ID}}": "User ID of single-level approver — to be resolved from SAP user master",
    "{{APPROVER_LEVEL1_USER_ID}}": "User ID of first-level approver (multi-level) — to be resolved from SAP user master",
    "{{APPROVER_LEVEL2_USER_ID}}": "User ID of second-level approver (multi-level) — to be resolved from SAP user master",
    "{{APPROVER_EMAIL}}": "Email address of approver user — to be resolved from SAP user profile",
    "{{REQUISITIONER_EMAIL}}": "Email address of requisitioner user — to be resolved from SAP user profile",
    "{{TODAY_PLUS_1_DAY}}": "Dynamic date: current date + 1 day (format: YYYY-MM-DD)",
    "{{TODAY_PLUS_7_DAYS}}": "Dynamic date: current date + 7 days (format: YYYY-MM-DD)",
    "{{TODAY_PLUS_10_DAYS}}": "Dynamic date: current date + 10 days (format: YYYY-MM-DD)",
    "{{TODAY_PLUS_14_DAYS}}": "Dynamic date: current date + 14 days (format: YYYY-MM-DD)",
    "{{TODAY_PLUS_21_DAYS}}": "Dynamic date: current date + 21 days (format: YYYY-MM-DD)",
    "{{PR_NUMBER_AWAITING_APPROVAL}}": "PR number of an existing PR that is not yet fully approved — to be created in prerequisite test",
    "{{PR_NUMBER_CREATED}}": "PR number created in test step — dynamically captured",
    "{{PR_NUMBER_APPROVED}}": "PR number of an approved PR — to be created in prerequisite test",
    "{{PR_NUMBER_REJECTED}}": "PR number of a rejected PR — to be created in prerequisite test",
    "{{APPROVER_REJECTION_COMMENTS}}": "Comments entered by approver during rejection — dynamically captured",
    "{{EMPTY_VALUE}}": "Leave field blank/empty (no value entered)",
    "{{AUTO_POPULATED}}": "Value is auto-filled by SAP — do not enter manually; verify after trigger action"
  }
}
