  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "text": "The user can mark a batch as \"Recalled\" in the batch master record or via a recall transaction.",
      "type": "NAVIGATION",
      "risk": "MEDIUM",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP"],
      "minTCCount": 1
    },
    {
      "id": "AC-2",
      "text": "The system immediately places an S&D block on all unrestricted stock of the recalled batch across all plants and storage locations.",
      "type": "BUSINESS_RULE",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "DT"],
      "scenarioTypesRequired": ["HP", "AP"],
      "minTCCount": 2
    },
    {
      "id": "AC-3",
      "text": "The system prevents creation of new Sales Orders for the recalled batch.",
      "type": "VALIDATION_NEGATIVE",
      "risk": "CRITICAL",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["NEG"],
      "minTCCount": 1
    },
    {
      "id": "AC-4",
      "text": "The system prevents release of existing Sales Orders that contain the recalled batch.",
      "type": "BUSINESS_RULE",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "ST"],
      "scenarioTypesRequired": ["NEG", "AP"],
      "minTCCount": 2
    },
    {
      "id": "AC-5",
      "text": "The system prevents picking and goods issue for Outbound Deliveries that contain the recalled batch.",
      "type": "BUSINESS_RULE",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "ST"],
      "scenarioTypesRequired": ["NEG"],
      "minTCCount": 1
    },
    {
      "id": "AC-6",
      "text": "The system sends a notification to all relevant stakeholders (Sales, Warehouse, Quality) when a batch is recalled and blocked.",
      "type": "SUCCESS_CONFIRMATION",
      "risk": "HIGH",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP"],
      "minTCCount": 1
    }
  ],
