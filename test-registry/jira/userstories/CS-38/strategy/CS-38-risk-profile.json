  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "text": "The user can create a Rebate Agreement specifying the GPO contract number, validity period, and eligible customers (GPO members).",
      "type": "NAVIGATION + MANDATORY_FIELD",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "BVA"],
      "scenarioTypesRequired": ["HP", "ERR", "NEG", "EDGE"],
      "minTCCount": 5
    },
    {
      "id": "AC-2",
      "text": "The system allows the user to define rebate tiers based on cumulative purchase volume (e.g., 2% rebate for 0-10,000 units, 4% rebate for 10,001-50,000 units).",
      "type": "BUSINESS_RULE + VALIDATION_POSITIVE",
      "risk": "HIGH",
      "testTechniques": ["EP", "BVA", "DT"],
      "scenarioTypesRequired": ["HP", "AP", "EDGE", "NEG", "ERR"],
      "minTCCount": 6
    },
    {
      "id": "AC-3",
      "text": "The system automatically accrues rebate amounts for each eligible customer based on their cumulative purchases during the contract period.",
      "type": "BUSINESS_RULE + INTEGRATION",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "ST"],
      "scenarioTypesRequired": ["HP", "INT", "EDGE"],
      "minTCCount": 3
    },
    {
      "id": "AC-4",
      "text": "The system provides a report showing cumulative purchases and accrued rebates for each GPO member.",
      "type": "VALIDATION_POSITIVE + SUCCESS_CONFIRMATION",
      "risk": "MEDIUM",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP", "AP"],
      "minTCCount": 2
    },
    {
      "id": "AC-5",
      "text": "The user can process a rebate settlement at the end of the contract period, generating credit memos or rebate payments for eligible customers.",
      "type": "BUSINESS_RULE + SUCCESS_CONFIRMATION",
      "risk": "CRITICAL",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP", "AP", "EDGE"],
      "minTCCount": 2
    },
    {
      "id": "AC-6",
      "text": "The system prevents retroactive changes to rebate tiers after the settlement has been processed.",
      "type": "VALIDATION_NEGATIVE + BUSINESS_RULE",
      "risk": "HIGH",
      "testTechniques": ["EP", "ST"],
      "scenarioTypesRequired": ["NEG"],
      "minTCCount": 1
    }
  ],
