  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "text": "The user can pick and pack an Outbound Delivery for a serialized pharmaceutical material.",
      "type": "NAVIGATION",
      "risk": "MEDIUM",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP"],
      "minTCCount": 1
    },
    {
      "id": "AC-2",
      "text": "The system requires the user to scan or enter the unique serial number for each unit of the serialized material.",
      "type": "MANDATORY_FIELD",
      "risk": "CRITICAL",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP", "ERR"],
      "minTCCount": 2
    },
    {
      "id": "AC-3",
      "text": "The system validates that the serial number is valid, has not already been shipped, and matches the batch number in the delivery.",
      "type": "VALIDATION_NEGATIVE",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "DT"],
      "scenarioTypesRequired": ["HP", "NEG"],
      "minTCCount": 4
    },
    {
      "id": "AC-4",
      "text": "The system captures the serial number, batch number, expiration date, and GTIN (Global Trade Item Number) for each unit.",
      "type": "VALIDATION_POSITIVE",
      "risk": "CRITICAL",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP"],
      "minTCCount": 1
    },
    {
      "id": "AC-5",
      "text": "The system generates a serialization event record (EPCIS format or equivalent) and uploads it to the Track-and-Trace repository or regulatory reporting system.",
      "type": "INTEGRATION",
      "risk": "CRITICAL",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP", "INT", "NEG"],
      "minTCCount": 3
    },
    {
      "id": "AC-6",
      "text": "The system blocks goods issue if serialization data is incomplete or invalid for any unit in the delivery.",
      "type": "ERROR_HANDLING",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "DT"],
      "scenarioTypesRequired": ["ERR"],
      "minTCCount": 2
    }
  ],
