  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "text": "The user can create a Scheduling Agreement specifying the customer (hospital), material (pharmaceutical product), total quantity, validity period, and delivery schedule.",
      "type": "BUSINESS_RULE",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "DT"],
      "scenarioTypesRequired": ["HP"],
      "minTCCount": 1
    },
    {
      "id": "AC-2",
      "text": "The system allows the user to define delivery schedules as fixed dates (e.g., first Monday of each month) or intervals (e.g., every 14 days).",
      "type": "BUSINESS_RULE",
      "risk": "HIGH",
      "testTechniques": ["EP", "DT"],
      "scenarioTypesRequired": ["HP", "AP"],
      "minTCCount": 3
    },
    {
      "id": "AC-3",
      "text": "The system automatically creates delivery schedule lines for each scheduled delivery date within the validity period.",
      "type": "VALIDATION_POSITIVE",
      "risk": "CRITICAL",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP"],
      "minTCCount": 1
    },
    {
      "id": "AC-4",
      "text": "The system allows the hospital to call off deliveries against the Scheduling Agreement by confirming the delivery schedule lines.",
      "type": "BUSINESS_RULE",
      "risk": "HIGH",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP"],
      "minTCCount": 1
    },
    {
      "id": "AC-5",
      "text": "The system tracks the cumulative quantity called off and remaining quantity under the Scheduling Agreement.",
      "type": "VALIDATION_POSITIVE",
      "risk": "HIGH",
      "testTechniques": ["EP", "BVA"],
      "scenarioTypesRequired": ["HP", "EDGE"],
      "minTCCount": 2
    },
    {
      "id": "AC-6",
      "text": "The system sends a notification to the Sales team when the Scheduling Agreement is nearing its validity end date or when the remaining quantity falls below a threshold.",
      "type": "SUCCESS_CONFIRMATION",
      "risk": "MEDIUM",
      "testTechniques": ["EP", "BVA"],
      "scenarioTypesRequired": ["HP", "EDGE"],
      "minTCCount": 3
    }
  ],
