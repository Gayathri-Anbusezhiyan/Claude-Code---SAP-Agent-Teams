      "risk": "MEDIUM",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP"],
      "minTCCount": 1
    },
    {
      "id": "AC-2",
      "text": "The system allows the user to specify the components to be provided to the CMO against the subcontracted finished material.",
      "type": "BUSINESS_RULE",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "DT"],
      "scenarioTypesRequired": ["HP", "AP", "NEG"],
      "minTCCount": 3
    },
    {
      "id": "AC-3",
      "text": "The system tracks components issued to the vendor as \"Stock provided to vendor\" inventory.",
      "type": "VALIDATION_POSITIVE",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "ST"],
      "scenarioTypesRequired": ["HP", "INT"],
      "minTCCount": 2
    },
    {
      "id": "AC-4",
      "text": "Upon goods receipt of the finished product, the system automatically consumes the corresponding component stock at the CMO.",
      "type": "BUSINESS_RULE",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "ST"],
      "scenarioTypesRequired": ["HP", "NEG", "EDGE"],
      "minTCCount": 3
    },
    {
      "id": "AC-5",
      "text": "The system triggers a quality inspection lot for the received finished goods per standard GMP receipt rules.",
      "type": "INTEGRATION",
      "risk": "CRITICAL",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP", "INT"],
      "minTCCount": 2
    },
    {
      "id": "AC-6",
      "text": "The user can view open component balances at the CMO through the \"Stock Overview\" app.",
      "type": "VALIDATION_POSITIVE",
      "risk": "MEDIUM",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP", "AP"],
      "minTCCount": 2
    }
  ],
