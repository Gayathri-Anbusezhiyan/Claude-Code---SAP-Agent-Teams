  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "text": "The user can access the \"Review Batch Records\" Fiori app.",
      "type": "NAVIGATION",
      "risk": "MEDIUM",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP"],
      "minTCCount": 1
    },
    {
      "id": "AC-2",
      "text": "The system compiles all process order data — component consumption, in-process controls, confirmations, and deviations — into a structured batch record.",
      "type": "VALIDATION_POSITIVE",
      "risk": "CRITICAL",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP", "INT"],
      "minTCCount": 2
    },
    {
      "id": "AC-3",
      "text": "The system prevents batch record approval if any mandatory in-process control result is missing or out of specification without a documented deviation.",
      "type": "VALIDATION_NEGATIVE",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "DT"],
      "scenarioTypesRequired": ["NEG", "HP"],
      "minTCCount": 3
    },
    {
      "id": "AC-4",
      "text": "The reviewer can add electronic signatures with a timestamp and user ID compliant with 21 CFR Part 11 requirements.",
      "type": "SUCCESS_CONFIRMATION",
      "risk": "CRITICAL",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP", "INT"],
      "minTCCount": 2
    },
    {
      "id": "AC-5",
      "text": "The batch cannot be transferred to Unrestricted-Use stock until the batch record is fully approved.",
      "type": "BUSINESS_RULE",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "ST"],
      "scenarioTypesRequired": ["HP", "NEG"],
      "minTCCount": 2
    },
    {
      "id": "AC-6",
      "text": "The completed, signed batch record is archived and retrievable for regulatory inspection.",
      "type": "SUCCESS_CONFIRMATION",
      "risk": "CRITICAL",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP"],
      "minTCCount": 2
    }
  ],
