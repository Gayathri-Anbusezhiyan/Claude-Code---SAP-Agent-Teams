  "hasLinkedIssues": false,
  "linkedIssueCount": 0,
  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "text": "The user can access the \"Manage Stock\" or \"Batch Where-Used List\" Fiori app.",
      "type": "NAVIGATION",
      "risk": "LOW",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP"],
      "minTCCount": 1
    },
    {
      "id": "AC-2",
      "text": "The user can select a specific batch and change its stock status to \"Blocked\" or \"Quality Inspection.\"",
      "type": "VALIDATION_POSITIVE",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "ST"],
      "scenarioTypesRequired": ["HP", "AP", "NEG", "ERR"],
      "minTCCount": 2
    },
    {
      "id": "AC-3",
      "text": "Once blocked, the system prevents any goods issue transaction against that batch, including production order consumption.",
      "type": "BUSINESS_RULE",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "ST"],
      "scenarioTypesRequired": ["HP", "NEG"],
      "minTCCount": 2
    },
    {
      "id": "AC-4",
      "text": "The system logs the reason code and the user who initiated the hold, along with a timestamp.",
      "type": "SUCCESS_CONFIRMATION",
      "risk": "HIGH",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP", "ERR"],
      "minTCCount": 1
    },
    {
      "id": "AC-5",
      "text": "The system allows an authorized QA user to release the hold once the investigation is closed, restoring the batch to Unrestricted-Use stock.",
      "type": "BUSINESS_RULE",
      "risk": "HIGH",
      "testTechniques": ["EP", "ST"],
      "scenarioTypesRequired": ["HP", "NEG", "EDGE"],
      "minTCCount": 2
    },
    {
      "id": "AC-6",
      "text": "A notification is sent to Production Planning when a batch used in an active process order is placed on hold.",
      "type": "INTEGRATION",
      "risk": "HIGH",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["INT"],
      "minTCCount": 1
    }
  ],
