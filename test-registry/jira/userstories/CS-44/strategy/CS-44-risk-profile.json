  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "text": "The user can create a Sales Order for a customer with a defined credit limit.",
      "type": "NAVIGATION",
      "risk": "MEDIUM",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP"],
      "minTCCount": 1
    },
    {
      "id": "AC-2",
      "text": "The system performs an automatic credit check when the Sales Order is saved or released.",
      "type": "BUSINESS_RULE",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "ST"],
      "scenarioTypesRequired": ["HP", "AP"],
      "minTCCount": 2
    },
    {
      "id": "AC-3",
      "text": "The system calculates the customer's total credit exposure (open sales orders + open deliveries + open invoices) and compares it to the credit limit.",
      "type": "BUSINESS_RULE",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "BVA"],
      "scenarioTypesRequired": ["HP", "EDGE"],
      "minTCCount": 3
    },
    {
      "id": "AC-4",
      "text": "The system blocks the Sales Order with a credit block status if the credit exposure exceeds the credit limit.",
      "type": "SUCCESS_CONFIRMATION",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "DT"],
      "scenarioTypesRequired": ["HP", "NEG"],
      "minTCCount": 2
    },
    {
      "id": "AC-5",
      "text": "The system displays a clear error message indicating the credit limit violation and shows the current credit exposure and limit.",
      "type": "ERROR_HANDLING",
      "risk": "HIGH",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP"],
      "minTCCount": 1
    },
    {
      "id": "AC-6",
      "text": "The system sends a notification to the Credit Control team when a Sales Order is blocked due to credit limit violation, allowing manual review and approval.",
      "type": "INTEGRATION",
      "risk": "HIGH",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP", "INT"],
      "minTCCount": 2
    }
  ],
