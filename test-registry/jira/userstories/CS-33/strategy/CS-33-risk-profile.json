  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "text": "The user can create a Sales Order for a pharmaceutical material that is batch-managed.",
      "type": "NAVIGATION + VALIDATION_POSITIVE",
      "risk": "CRITICAL",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP"],
      "minTCCount": 1
    },
    {
      "id": "AC-2",
      "text": "The system automatically determines the batch with the nearest expiration date for the order quantity.",
      "type": "BUSINESS_RULE",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "BVA"],
      "scenarioTypesRequired": ["HP", "EDGE"],
      "minTCCount": 2
    },
    {
      "id": "AC-3",
      "text": "The system excludes batches that have expired or are within the minimum remaining shelf-life threshold (configurable by material).",
      "type": "VALIDATION_NEGATIVE + BUSINESS_RULE",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "BVA"],
      "scenarioTypesRequired": ["NEG", "EDGE"],
      "minTCCount": 3
    },
    {
      "id": "AC-4",
      "text": "The system splits the order across multiple batches if a single batch does not have sufficient quantity.",
      "type": "BUSINESS_RULE",
      "risk": "HIGH",
      "testTechniques": ["EP", "BVA"],
      "scenarioTypesRequired": ["AP", "EDGE"],
      "minTCCount": 2
    },
    {
      "id": "AC-5",
      "text": "The system displays the selected batch number(s) and expiration date(s) in the Sales Order line items.",
      "type": "SUCCESS_CONFIRMATION",
      "risk": "CRITICAL",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP"],
      "minTCCount": 1
    },
    {
      "id": "AC-6",
      "text": "The system sends a warning if no batch with sufficient remaining shelf-life is available for the order quantity.",
      "type": "ERROR_HANDLING",
      "risk": "HIGH",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["NEG"],
      "minTCCount": 1
    }
  ],
