  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "text": "The user can create a Sales Order for an international customer (ship-to country different from company country).",
      "type": "NAVIGATION",
      "risk": "MEDIUM",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP"],
      "minTCCount": 1
    },
    {
      "id": "AC-2",
      "text": "The system automatically screens the customer (Sold-To, Ship-To, Bill-To, Payer) against government-maintained denied-party lists (e.g., OFAC, BIS, EU sanctions).",
      "type": "INTEGRATION",
      "risk": "CRITICAL",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP", "NEG", "INT"],
      "minTCCount": 3
    },
    {
      "id": "AC-3",
      "text": "The system blocks release of the Sales Order if the customer or any party matches a denied-party list entry.",
      "type": "BUSINESS_RULE",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "DT"],
      "scenarioTypesRequired": ["HP", "NEG"],
      "minTCCount": 2
    },
    {
      "id": "AC-4",
      "text": "The system displays a clear error message indicating the export compliance violation and provides the matched party name and list source.",
      "type": "ERROR_HANDLING",
      "risk": "CRITICAL",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["NEG"],
      "minTCCount": 1
    },
    {
      "id": "AC-5",
      "text": "The system logs all denied-party screening checks and matches for audit and regulatory reporting.",
      "type": "SUCCESS_CONFIRMATION",
      "risk": "CRITICAL",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP", "NEG"],
      "minTCCount": 2
    },
    {
      "id": "AC-6",
      "text": "The system allows authorized users (e.g., Export Compliance Officer) to review and override false-positive matches with documented justification.",
      "type": "BUSINESS_RULE",
      "risk": "HIGH",
      "testTechniques": ["EP", "DT"],
      "scenarioTypesRequired": ["AP", "NEG", "ERR"],
      "minTCCount": 3
    }
  ],
