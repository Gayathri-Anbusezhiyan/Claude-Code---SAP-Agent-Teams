  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "text": "The user can access the \"Create Quality Notification\" Fiori app, triggered from the in-process control result entry.",
      "type": "NAVIGATION + INTEGRATION",
      "risk": "HIGH",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP", "INT"],
      "minTCCount": 2
    },
    {
      "id": "AC-2",
      "text": "The system automatically pre-populates the deviation with the process order, operation, batch, and out-of-spec result.",
      "type": "VALIDATION_POSITIVE + BUSINESS_RULE",
      "risk": "CRITICAL",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP", "NEG"],
      "minTCCount": 2
    },
    {
      "id": "AC-3",
      "text": "The process order is automatically placed on hold at the affected operation pending deviation disposition.",
      "type": "BUSINESS_RULE + STATE_TRANSITION",
      "risk": "CRITICAL",
      "testTechniques": ["ST"],
      "scenarioTypesRequired": ["HP", "NEG"],
      "minTCCount": 2
    },
    {
      "id": "AC-4",
      "text": "The QA user can document root cause, impact assessment, and corrective/preventive action (CAPA) on the deviation record.",
      "type": "MANDATORY_FIELD + BUSINESS_RULE",
      "risk": "HIGH",
      "testTechniques": ["EP", "DT"],
      "scenarioTypesRequired": ["HP", "ERR"],
      "minTCCount": 4
    },
    {
      "id": "AC-5",
      "text": "The process order cannot proceed to the next operation until the deviation is formally closed with an approved disposition.",
      "type": "BUSINESS_RULE + STATE_TRANSITION",
      "risk": "CRITICAL",
      "testTechniques": ["ST", "DT"],
      "scenarioTypesRequired": ["HP", "NEG"],
      "minTCCount": 3
    },
    {
      "id": "AC-6",
      "text": "A trend report is available showing deviation frequency by material, operation, and root-cause category.",
      "type": "SUCCESS_CONFIRMATION + BUSINESS_RULE",
      "risk": "MEDIUM",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP"],
      "minTCCount": 1
    }
  ],
