  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "text": "The user can access the \"Manage Stock\" Fiori app or a scheduled background job for expiration monitoring.",
      "type": "NAVIGATION",
      "risk": "LOW",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP"],
      "minTCCount": 1
    },
    {
      "id": "AC-2",
      "text": "The system runs a daily background check comparing batch expiration dates to the current date.",
      "type": "BUSINESS_RULE",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "ST"],
      "scenarioTypesRequired": ["HP", "NEG", "EDGE"],
      "minTCCount": 3
    },
    {
      "id": "AC-3",
      "text": "Batches identified as expired are automatically restricted from unrestricted-use stock.",
      "type": "BUSINESS_RULE",
      "risk": "CRITICAL",
      "testTechniques": ["EP", "BVA"],
      "scenarioTypesRequired": ["HP", "EDGE"],
      "minTCCount": 3
    },
    {
      "id": "AC-4",
      "text": "The system generates a notification to the Warehouse and QA teams listing newly expired batches.",
      "type": "SUCCESS_CONFIRMATION",
      "risk": "HIGH",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP", "NEG"],
      "minTCCount": 2
    },
    {
      "id": "AC-5",
      "text": "An authorized user must complete a disposition (destroy, return, rework) before the batch can be removed from blocked status.",
      "type": "MANDATORY_FIELD",
      "risk": "HIGH",
      "testTechniques": ["EP", "DT"],
      "scenarioTypesRequired": ["HP", "NEG", "ERR"],
      "minTCCount": 3
    },
    {
      "id": "AC-6",
      "text": "The system maintains a report of all expired batch dispositions for regulatory audit.",
      "type": "SUCCESS_CONFIRMATION",
      "risk": "CRITICAL",
      "testTechniques": ["EP"],
      "scenarioTypesRequired": ["HP"],
      "minTCCount": 1
    }
  ],
